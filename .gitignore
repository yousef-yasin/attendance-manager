# --------------------------------------------------------------------------
# Student data protection
# Real attendance files, rosters, reports, databases and backups contain
# personal information (names, student IDs, e-mail addresses) and must never
# be committed. Only the synthetic test fixtures are allowed.
# --------------------------------------------------------------------------
tests/fixtures/real/*
!tests/fixtures/real/README.md

*.xls
*.xlsx
*.xlsm
*.xlsb
*.csv
*.tsv
!tests/fixtures/synthetic/*

# Application data (SQLite database, uploaded originals, backups, logs)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.zip
*.log
app.lock

# Secrets and signing material
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
*.cer
*.spc
secrets/

# --------------------------------------------------------------------------
# Python / tooling
# --------------------------------------------------------------------------
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
*.egg-info/
.eggs/

# --------------------------------------------------------------------------
# Build output (the installer is published as a GitHub Release asset)
# --------------------------------------------------------------------------
build/
dist/
*.exe
*.msi

# --------------------------------------------------------------------------
# Editors and operating system files
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
